    {
      "parameters": {
        "jsCode": "// Get the first input item (this includes both JSON + Binary)\nconst item = $input.item.json ? $input.item : $input.first();\n\n// Initialize text\nlet text = \"\";\n\n// Safely access WhatsApp payload\nconst msg = item.json.messages?.[0] || {};\n\n// Text or document caption\nif (msg.text?.body) {\n  text = msg.text.body;\n} else if (msg.document?.caption) {\n  text = msg.document.caption;\n}\n\n// Clean up text\ntext = (text || \"\").trim();\n\n// Split into command + args\nconst parts = text.split(/\\s+/).filter(Boolean);\nconst command = (parts.shift() || \"\").toUpperCase();\nconst args = parts;\n\n// ✅ Return item while preserving binary data\nreturn [\n  {\n    json: {\n      ...item.json,\n      command,\n      args,\n      rawMessage: text,\n      source: msg.type || \"unknown\",\n    },\n    // Preserve binary if file is attached\n    binary: item.binary || undefined,\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "fbf4ca33-29f1-4b5c-bbd2-4f73600e1f13",
