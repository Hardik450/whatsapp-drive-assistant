      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "pythonNative",
        "pythonCode": "import base64\nfrom io import BytesIO\n\n# Install PyPDF2 in n8n Python Node if not installed\n# !pip install PyPDF2\n\nfrom PyPDF2 import PdfReader\n\n# Get binary data from n8n input\nbinary_data = items[0]['binary']['data']['data']  # base64 string\nfile_name = items[0]['binary']['data']['fileName']  # optional, for extension\n\n# Decode base64 to bytes\nfile_bytes = base64.b64decode(binary_data)\n\ntext = \"\"\n\n# Check file type by extension\nif file_name.lower().endswith(\".pdf\"):\n    pdf = PdfReader(BytesIO(file_bytes))\n    for page in pdf.pages:\n        text += page.extract_text() + \"\\n\"\nelse:\n    # For txt or doc files, just decode bytes to string\n    text = file_bytes.decode(\"utf-8\")\n\nreturn [{\"json\": {\"content\": text}}]\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
